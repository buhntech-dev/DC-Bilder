# Discord Developer Portal -> Bot -> Token (NEU GENERIEREN, falls alter Token bereits veröffentlicht war)
DISCORD_TOKEN=DEIN_NEUER_DISCORD_BOT_TOKEN

# Discord Developer Portal -> General Information -> Application ID
CLIENT_ID=DEINE_APPLICATION_ID

# Discord Server-ID (für schnelle Registrierung der Slash-Befehle)
GUILD_ID=DEINE_SERVER_ID

# Deine Discord-Benutzer-ID: Nur du darfst /build und /plan verwenden
OWNER_ID=DEINE_DISCORD_BENUTZER_ID

# Kein OPENAI_API_KEY nötig – der Bot läuft vollständig im kostenlosen Regel-Modus.
