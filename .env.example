# Discord Developer Portal -> Bot -> Token (niemals committen oder teilen)
DISCORD_TOKEN=HIER_NEUEN_BOT_TOKEN_EINTRAGEN

# Discord Developer Portal -> General Information -> Application ID
CLIENT_ID=DEINE_APPLICATION_ID

# Discord Server-ID für schnelle Slash-Befehlsregistrierung
GUILD_ID=DEINE_SERVER_ID

# Discord Benutzer-ID des Bot-Besitzers
OWNER_ID=DEINE_DISCORD_USER_ID

# Optional: Voice-Kanal-ID, in dem der Bot erreichbar bleiben soll
# SUPPORT_VOICE_CHANNEL_ID=

# Minecraft Java Serverstatus (Standard: Communety.aternos.me:18884)
MINECRAFT_ADDRESS=Communety.aternos.me:18884

# Optional: automatische Minecraft-Whitelist über RCON (nur wenn dein Server RCON unterstützt)
# RCON_HOST=Communety.aternos.me
# RCON_PORT=25575
# RCON_PASSWORD=DEIN_RCON_PASSWORT

# Optional: Discord-Einladungslink für die generierte Website
# DISCORD_INVITE_URL=https://discord.gg/DEIN-CODE

# Fraktions-Webdashboard (Discord OAuth)
DISCORD_CLIENT_ID=DEINE_APPLICATION_ID
DISCORD_CLIENT_SECRET=OAUTH_CLIENT_SECRET
FRACTION_GUILD_ID=DEINE_DISCORD_SERVER_ID
FRACTION_SESSION_SECRET=LANGER_ZUFAELLIGER_GEHEIMER_WERT
FRACTION_API_URL=https://DEIN-RAILWAY-DOMAIN
FRACTION_WEB_URL=https://buhntech-dev.github.io/Ki-webseite
# Optional: FRACTION_DATA_FILE=/data/fractions.json (Railway Volume empfohlen)
