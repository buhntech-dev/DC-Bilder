# Discord Developer Portal -> Bot -> Token (niemals committen oder teilen)
DISCORD_TOKEN=HIER_NEUEN_BOT_TOKEN_EINTRAGEN

# Discord Developer Portal -> General Information -> Application ID
CLIENT_ID=DEINE_APPLICATION_ID

# Discord Server-ID für schnelle Slash-Befehlsregistrierung
GUILD_ID=DEINE_SERVER_ID

# Discord Benutzer-ID des Bot-Besitzers
OWNER_ID=DEINE_DISCORD_USER_ID

# Optional: Voice-Kanal-ID, in dem der Bot erreichbar bleiben soll
# SUPPORT_VOICE_CHANNEL_ID=
